# Copy to .env for local overrides. Only the Qdrant connection and the OpenRouter key are
# read from the environment by `minicoil` commands; everything else is a CLI flag.
# Without a .env the pipeline uses a local Qdrant at http://localhost:6333.

# Qdrant Cloud cluster (used by `minicoil train` and `minicoil embed --cloud-inference`)
# MINICOIL_QDRANT_URL=https://your-cluster.qdrant.io
# MINICOIL_QDRANT_API_KEY=

# Hosted teacher for `minicoil embed --cloud-inference --mining-pooling sentence
# --mining-encoder openrouter/qwen/qwen3-embedding-8b` (used in early runs). The published
# checkpoint was embedded on a GPU machine instead, with
# --mining-encoder Qwen/Qwen3-Embedding-0.6B --mining-pooling sentence (see README).
# MINICOIL_EMBED_OPENROUTER_API_KEY=
